# Server Configuration
PORT=8000
NODE_ENV=development

# Database Connection (PostgreSQL - Supabase)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# JWT Auth Secrets
JWT_SECRET="replace_with_a_secure_random_string_in_production"
JWT_EXPIRES_IN="7d"

# Supabase Storage Configuration (Required for file uploads)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Zoho CRM Integration Configuration
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_VERSION=v8
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token
ZOHO_API_DOMAIN=https://www.zohoapis.in
ZOHO_CONTACTS_MODULE=Contacts
ZOHO_ENQUIRY_MODULE=Website_Enquiries
ZOHO_SYNC_ENABLED=false
ZOHO_SYNC_TIMEOUT_MS=8000
ZOHO_MAX_AUTO_ATTEMPTS=6

