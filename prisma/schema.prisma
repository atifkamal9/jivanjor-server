datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  SUPER_ADMIN
  USER
}

model User {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  password    String
  role        Role     @default(USER)
  permissions String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model ProductCategory {
  id          String            @id @default(uuid())
  name        String
  slug        String            @unique
  parentId    String?           @map("parent_id")
  description String?
  tagline     String?
  icon        String?           // Pre-stored platform icon key (e.g. Lucide icon name)
  isVisible   Boolean           @default(true) @map("is_visible")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  // Relationships
  parent      ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    ProductCategory[] @relation("CategoryHierarchy")
  products    Product[]

  @@map("product_categories")
}

model Material {
  id           String    @id @default(uuid())
  materialName String    @map("material_name")
  description  String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relationships
  products     Product[]

  @@map("materials")
}

model Product {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  description      String
  shortDescription String?  @map("short_description")
  categoryId       String   @map("category_id")
  categoryIds      String[] @default([]) @map("category_ids")
  materialId       String?  @map("material_id")
  image            String?
  metadata         Json?    // Custom dynamic attributes
  rightChoice      Json?    @map("right_choice")
  isVisible        Boolean  @default(true) @map("is_visible")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relationships
  category    ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  material    Material?       @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@map("products")
}

model UseCase {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String
  content     String?
  category    String?
  image       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("use_cases")
}

model Issue {
  id         String   @id @default(uuid())
  issueTitle String   @map("issue_title")
  slug       String   @unique
  problem    String
  solution   String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("issues")
}

model BlogPost {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String
  category    String   // Tag/category group name
  tags        Json?    // Array of tags (e.g. ["plumbing", "adhesive"])
  author      String
  authorDescription String? @map("author_description")
  authorAvatar      String? @map("author_avatar")
  publishDate DateTime @default(now()) @map("publish_date")
  image       String?
  tldr        String?  // Summary description
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("blog_posts")
}

model SEOMetadata {
  id              String   @id @default(uuid())
  pageType        String   @map("page_type") // e.g. "PRODUCT", "CATEGORY", "MATERIAL", "USE_CASE", "ISSUE", "BLOG", "STATIC"
  pageId          String?  @map("page_id")   // ID of target resource, if applicable
  metaTitle       String   @map("meta_title")
  metaDescription String   @map("meta_description")
  canonicalUrl    String?  @map("canonical_url")
  image           String?  @map("image")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([pageType, pageId])
  @@map("seo_metadata")
}

model Page {
  id               String        @id @default(uuid())
  title            String
  slug             String        @unique
  description      String?
  activeTemplateId String?       @map("active_template_id")
  sections         Json?         @map("sections")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  // Relationships
  activeTemplate   PageTemplate? @relation("ActiveTemplate", fields: [activeTemplateId], references: [id], onDelete: SetNull)

  @@map("pages")
}

model PageTemplate {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  sections  Json     // Fully dynamic sections and blocks (headers, paragraphs, images, videos)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  activeFor Page[]   @relation("ActiveTemplate")

  @@map("page_templates")
}

model Menu {
  id             String   @id @default("header_menu")
  name           String   @default("Main Header Navigation")
  draftItems     Json     @map("draft_items")
  publishedItems Json     @map("published_items")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("menus")
}

model SiteSetting {
  id                String   @id @default("site_settings")
  desktopLogo       String?  @map("desktop_logo")
  mobileLogo        String?  @map("mobile_logo")
  headerDesktopLogo String?  @map("header_desktop_logo")
  headerMobileLogo  String?  @map("header_mobile_logo")
  footerDesktopLogo String?  @map("footer_desktop_logo")
  footerMobileLogo  String?  @map("footer_mobile_logo")
  categoryHeroCover String?  @map("category_hero_cover")
  categoryCardBg    String?  @map("category_card_bg")
  socialLinks       Json?    @map("social_links")
  rightChoiceBanner Json?    @map("right_choice_banner")
  contactPage       Json?    @map("contact_page")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

enum CrmSyncStatus {
  PENDING
  PROCESSING
  RETRY_SCHEDULED
  SYNCED
  FAILED
  MANUAL_REVIEW
}

enum FormType {
  CONTACT
  DEALER
  CONTRACTOR
}

model FormSubmission {
  id                  String        @id @default(uuid())
  crmExternalKey      String        @unique @map("crm_external_key")
  formType            FormType      @map("form_type")
  fullName            String        @map("full_name")
  firmName            String?       @map("firm_name")
  mobileRaw           String        @map("mobile_raw")
  mobileNormalized    String        @map("mobile_normalized")
  email               String?
  city                String?
  location            String?       @map("location")
  state               String?       @map("state")
  pinCode             String?       @map("pin_code")
  queryType           String?       @map("query_type")
  interestedIn        String?       @map("interested_in")
  lineOfBusiness      String?       @map("line_of_business")
  message             String?
  consentGiven        Boolean       @map("consent_given")
  consentTextVersion  String?       @map("consent_text_version")
  sourceUrl           String?       @map("source_url")
  referrerUrl         String?       @map("referrer_url")
  utmSource           String?       @map("utm_source")
  utmMedium           String?       @map("utm_medium")
  utmCampaign         String?       @map("utm_campaign")
  utmContent          String?       @map("utm_content")
  utmTerm             String?       @map("utm_term")
  gclid               String?
  fbclid              String?
  submittedAt         DateTime      @default(now()) @map("submitted_at")
  zohoSyncStatus      CrmSyncStatus @default(PENDING) @map("zoho_sync_status")
  zohoContactId       String?       @map("zoho_contact_id")
  zohoEnquiryId       String?       @map("zoho_enquiry_id")
  zohoContactAction   String?       @map("zoho_contact_action")
  zohoEnquiryAction   String?       @map("zoho_enquiry_action")
  zohoSyncAttempts    Int           @default(0) @map("zoho_sync_attempts")
  zohoLastHttpStatus  Int?          @map("zoho_last_http_status")
  zohoLastErrorCode   String?       @map("zoho_last_error_code")
  zohoLastErrorMessage String?      @map("zoho_last_error_message")
  zohoLastResponse    Json?         @map("zoho_last_response")
  zohoLastAttemptAt   DateTime?     @map("zoho_last_attempt_at")
  zohoSyncedAt        DateTime?     @map("zoho_synced_at")
  nextRetryAt         DateTime?     @map("next_retry_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  syncJob  CrmSyncJob?
  attempts CrmSyncAttempt[]

  @@map("form_submissions")
}

model CrmSyncJob {
  id           String        @id @default(uuid())
  submissionId String        @unique @map("submission_id")
  status       CrmSyncStatus @default(PENDING)
  availableAt  DateTime      @default(now()) @map("available_at")
  lockedAt     DateTime?     @map("locked_at")
  workerId     String?       @map("worker_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  submission FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("crm_sync_jobs")
}

model CrmSyncAttempt {
  id              String        @id @default(uuid())
  submissionId    String        @map("submission_id")
  attemptNumber   Int           @map("attempt_number")
  source          String        @map("source")
  actor           String?       @map("actor")
  status          CrmSyncStatus @map("status")
  httpStatus      Int?          @map("http_status")
  errorCode       String?       @map("error_code")
  errorMessage    String?       @map("error_message")
  responsePayload Json?         @map("response_payload")
  startedAt       DateTime      @default(now()) @map("started_at")
  completedAt     DateTime?     @map("completed_at")

  submission FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("crm_sync_attempts")
}

model AdminAuditLog {
  id             String         @id @default(uuid())
  adminUserId    String         @map("admin_user_id")
  action         String         @map("action")
  submissionId   String?        @map("submission_id")
  reason         String?
  previousStatus CrmSyncStatus? @map("previous_status")
  newStatus      CrmSyncStatus? @map("new_status")
  details        Json?
  ipAddress      String?        @map("ip_address")
  createdAt      DateTime       @default(now()) @map("created_at")

  @@map("admin_audit_log")
}

model PinCode {
  pinCode   String   @id @map("pin_code")
  location  String?  @map("location")
  city      String
  state     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pincodes")
}




