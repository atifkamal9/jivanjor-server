datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  USER
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model ProductCategory {
  id          String            @id @default(uuid())
  name        String
  slug        String            @unique
  parentId    String?           @map("parent_id")
  description String?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  // Relationships
  parent      ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    ProductCategory[] @relation("CategoryHierarchy")
  products    Product[]

  @@map("product_categories")
}

model Material {
  id           String    @id @default(uuid())
  materialName String    @map("material_name")
  description  String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relationships
  products     Product[]

  @@map("materials")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String
  categoryId  String   @map("category_id")
  materialId  String?  @map("material_id")
  image       String?
  metadata    Json?    // Custom dynamic attributes
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relationships
  category    ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  material    Material?       @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@map("products")
}

model UseCase {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("use_cases")
}

model Issue {
  id         String   @id @default(uuid())
  issueTitle String   @map("issue_title")
  slug       String   @unique
  problem    String
  solution   String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("issues")
}

model BlogPost {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String
  category    String   // Tag/category group name
  tags        Json?    // Array of tags (e.g. ["plumbing", "adhesive"])
  author      String
  publishDate DateTime @default(now()) @map("publish_date")
  image       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("blog_posts")
}

model SEOMetadata {
  id              String   @id @default(uuid())
  pageType        String   @map("page_type") // e.g. "PRODUCT", "CATEGORY", "MATERIAL", "USE_CASE", "ISSUE", "BLOG", "STATIC"
  pageId          String?  @map("page_id")   // ID of target resource, if applicable
  metaTitle       String   @map("meta_title")
  metaDescription String   @map("meta_description")
  canonicalUrl    String?  @map("canonical_url")
  image           String?  @map("image")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([pageType, pageId])
  @@map("seo_metadata")
}

model Page {
  id               String        @id @default(uuid())
  title            String
  slug             String        @unique
  description      String?
  activeTemplateId String?       @map("active_template_id")
  sections         Json?         @map("sections")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  // Relationships
  activeTemplate   PageTemplate? @relation("ActiveTemplate", fields: [activeTemplateId], references: [id], onDelete: SetNull)

  @@map("pages")
}

model PageTemplate {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  sections  Json     // Fully dynamic sections and blocks (headers, paragraphs, images, videos)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  activeFor Page[]   @relation("ActiveTemplate")

  @@map("page_templates")
}
